# Ghostty Configuration

# デスクトップ通知を有効化（OSC 9, OSC 777シーケンスで通知を表示）
desktop-notifications = true

# 外観
theme = Catppuccin Macchiato
font-family = Osaka−等幅
font-size = 15
background-opacity = 1.0
background-blur-radius = 20
window-decoration = true
mouse-hide-while-typing = true

# Quick Terminal の設定
# 他のアプリにフォーカスが移っても自動的に隠れないようにする
quick-terminal-autohide = false
quick-terminal-position = bottom

# global: を付けないと Ghostty にフォーカスがある時しか発火しない
keybind = global:cmd+opt+t=toggle_quick_terminal

# ペイン移動（cmd+h の macOS デフォルト動作を無効化した上で再バインド）
keybind = cmd+h=unbind
keybind = cmd+h=goto_split:previous
keybind = cmd+l=goto_split:next

# スクロール（Neovim 風）: ctrl+shift+up/down を送り、全画面アプリ側で 1 行送りに割り当てる
keybind = cmd+shift+j=text:\x1b[1;6B
keybind = cmd+shift+k=text:\x1b[1;6A

# 非フォーカス split を暗くしてフォーカスを明確にする
unfocused-split-opacity = 0.5
split-divider-color = #8bd5ca

# フルスクリーントグルを無効化
keybind = cmd+enter=unbind
keybind = ctrl+cmd+f=unbind

# Allow terminal apps such as Herdr to receive mouse clicks.
mouse-reporting = true

# Send macOS Option as Alt so Herdr can use Option+Space as its prefix.
macos-option-as-alt = true
